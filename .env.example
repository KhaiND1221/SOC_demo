# ==============================================================
# SOC Logging Lab - environment variables
# Copy this file to ".env" before running docker compose up.
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
# NEVER commit the real ".env" file - it is meant to hold secrets.
# ==============================================================

# ---- PostgreSQL ----
POSTGRES_USER=soclab
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=soclab
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Nginx (host port mapping) ----
NGINX_PORT=8080
# HTTPS (self-signed cert, see nginx/ssl/) - https://localhost:8443
NGINX_HTTPS_PORT=8443

# ---- Session / Auth cookie ----
SESSION_COOKIE_NAME=session_id
# Absolute session lifetime in minutes from the moment of login.
SESSION_TIMEOUT_MINUTES=30
# true because Nginx now force-redirects all HTTP -> HTTPS (see
# nginx/nginx.conf), so every real request is HTTPS - safe to require it.
# Only set this back to "false" if you remove the HTTP->HTTPS redirect.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict

# ---- Auth rate limiting / lockout ----
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=5
RATE_LIMIT_LOCKOUT_MINUTES=5

# ---- App / logging ----
APP_ENV=production-like
LOG_LEVEL=INFO
